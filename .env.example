# Public base URL, used for canonical URLs, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase. Leave blank to run entirely from the bundled seed content.
# When these are blank, feedback and repair reports are NOT stored anywhere and the UI says so.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by API routes to write feedback and by `npm run db:seed`.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where public content is read from: "local" (default, bundled seed) or "supabase".
CONTENT_SOURCE=local
